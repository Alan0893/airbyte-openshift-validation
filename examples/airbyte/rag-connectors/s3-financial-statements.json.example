{
  "bucket": "REPLACE_FINANCIAL_STATEMENTS_BUCKET",
  "credentials": {
    "auth_type": "iam_user",
    "aws_access_key_id": "REPLACE_WITH_S3_ACCESS_KEY",
    "aws_secret_access_key": "REPLACE_WITH_S3_SECRET_KEY"
  },
  "region_name": "us-east-1",
  "endpoint": "",
  "start_date": "2024-01-01T00:00:00Z",
  "streams": [
    {
      "name": "financial_statement_tsv_files",
      "globs": ["financial-statements/**/*.tsv"],
      "format": {
        "filetype": "csv"
      }
    }
  ],
  "delivery_method": {
    "delivery_type": "use_file_transfer",
    "preserve_directory_structure": true
  }
}
